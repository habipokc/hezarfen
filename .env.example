# Hezarfen environment configuration.
# Copy to .env (`make env` does this) and adjust. .env is gitignored — never commit secrets.

# --- Host ports (only these are exposed on the host) ---------------------------
# Single entry point: /, /api, /ws, /ops, /tiles
HEZARFEN_HTTP_PORT=8800
# Debug-only, bound to 127.0.0.1 (psql, QGIS, redis-cli)
HEZARFEN_DB_PORT=55432
HEZARFEN_REDIS_PORT=56379

# --- PostgreSQL / PostGIS ------------------------------------------------------
POSTGRES_DB=hezarfen
POSTGRES_USER=hezarfen
# Dev-only default. Change it for anything exposed beyond your machine.
POSTGRES_PASSWORD=hezarfen

# --- Django --------------------------------------------------------------------
# Dev-only default. Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-change-me
# 1 for the dev stack; `make up-prod` always overrides it with 0
DJANGO_DEBUG=1
# Comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Comma-separated origins allowed for CSRF (needed for admin behind nginx on a non-80 port)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8800,http://127.0.0.1:8800
DJANGO_LOG_LEVEL=INFO

# --- Ingest (Go) ---------------------------------------------------------------
# auto | live | replay | synthetic
#   auto: live if OpenSky credentials exist, else replay if REPLAY_DIR has recordings, else synthetic
#   live without credentials uses anonymous access (400 credits/day, 10 s resolution)
SOURCE_MODE=auto
# OpenSky OAuth2 client credentials (https://opensky-network.org -> Account -> API client).
# Leave both empty to run without live data. Never commit real values.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Daily credit budget used by adaptive polling (default: 4000 with credentials, 400 anonymous)
# OPENSKY_DAILY_CREDITS=4000
# Live polling interval in seconds; raised to the slow interval when credits < 20% of the budget
POLL_INTERVAL_SECONDS=10
POLL_INTERVAL_SLOW_SECONDS=30
# Replay: directory of recordings (default: $DATA_DIR/raw, where live mode archives) and speed
# multiplier (1 = real time, 5 = five times faster). Try the bundled fixture in the dev stack:
#   REPLAY_DIR=/src/testdata/opensky
# REPLAY_DIR=/data/raw
REPLAY_SPEED=1
# Synthetic: number of aircraft, tick in seconds (1-5), random seed (0 = new fleet on every start)
SYNTHETIC_AIRCRAFT=60
SYNTHETIC_TICK_SECONDS=2
SYNTHETIC_SEED=1
# Region bounding box (Marmara by default): lamin, lomin, lamax, lomax
BBOX_LAMIN=39.5
BBOX_LOMIN=26.0
BBOX_LAMAX=42.0
BBOX_LOMAX=31.5
INGEST_LOG_LEVEL=INFO
# The ingest container runs as this uid:gid so files it writes under ./data belong to you.
# The Makefile exports your `id -u`/`id -g`; set them here only if you run `docker compose` directly
# with a uid other than 1000.
# HEZARFEN_UID=1000
# HEZARFEN_GID=1000
# Overridable for tests/mirrors; the defaults are OpenSky's public endpoints
# OPENSKY_API_URL=https://opensky-network.org/api
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# --- Backend API ---------------------------------------------------------------
# Where /api/stats and /ops/ read ingest metrics (compose network); BBOX_* above is shared
# INGEST_METRICS_URL=http://ingest:8080/metrics
# Redis channel for geofence change notifications to the relay (ICD §4.3)
# GEOFENCES_CHANGED_CHANNEL=geofences.changed

# --- Retention -----------------------------------------------------------------
# Position history older than this is deleted by the maintenance service (and the /ops button)
POSITIONS_RETENTION_DAYS=7
# How often the maintenance service runs retention, in seconds (first run 30 s after start)
RETENTION_INTERVAL_SECONDS=3600
